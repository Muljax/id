# Instance Configuration
INSTANCE_NAME=muljax-id

# Dashboard Configuration
# Do not include the protocol (http:// or https://) in the domain name.
DASHBOARD_DOMAIN=muljax-id-dashboard.wrappeddeveloper.workers.dev

# This is prefixed with vite_ to expose it to Vite properly
VITE_API_URL=https://muljax-id-api.wrappeddeveloper.workers.dev

# Boolean true/false, defaults to false
LOCALHOST=false

# API Configuration
# API Domain, must include the protocol (http:// or https://) in the domain name.
OIDC_ISSUER=https://muljax-id-api.wrappeddeveloper.workers.dev

# ------------------------------------------------------------
# SECRETS

ADMIN_BOOTSTRAP_SECRET=
OIDC_PRIVATE_KEY=
