{
 "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
 "vcs": {
  "enabled": false
 },
 "files": {
  "ignoreUnknown": false,
  "includes": [
   "**",
   "!**/worker-configuration.d.ts",
   "!./bun.lock",
   "!./biome.json",
   "!dist",
   "!**/.wrangler"
  ]
 },
 "formatter": {
  "enabled": true,
  "indentStyle": "tab"
 },
 "overrides": [
  {
   "includes": ["**/*.json", "**/*.jsonc", "**/*.yml", "**/*.yaml"],
   "formatter": {
    "indentStyle": "space",
    "indentWidth": 1
   }
  },
  {
   "includes": ["**/*.jsonc"],
   "formatter": {
    "trailingCommas": "none"
   }
  },
  {
   "includes": ["**/package.json", "package.json"],
   "formatter": {
    "enabled": false
   }
  }
 ],
 "linter": {
  "enabled": true,
  "rules": {
   "preset": "recommended",
   "correctness": {
    "useExhaustiveDependencies": "warn"
   },
   "suspicious": {
    "noAssignInExpressions": "warn",
    "noArrayIndexKey": "warn"
   },
   "a11y": {
    "noStaticElementInteractions": "warn"
   }
  }
 },
 "javascript": {
  "formatter": {
   "quoteStyle": "double"
  }
 },
 "css": {
  "parser": {
   "tailwindDirectives": true
  }
 },
 "assist": {
  "enabled": false,
  "actions": {
   "source": {
    "organizeImports": "on"
   }
  }
 }
}
