{
 "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
 "root": true,
 "vcs": {
  "enabled": false,
  "clientKind": "git",
  "useIgnoreFile": false
 },
 "files": {
  "ignoreUnknown": false,
  "includes": [
   "**",
   "!**/dist",
   "!**/*.gen.ts",
   "!**/worker-configuration.d.ts",
   "!./bun.lock",
   "!./biome.json"
  ]
 },
 "formatter": {
  "enabled": true,
  "indentStyle": "tab"
 },
 "css": {
  "parser": {
   "tailwindDirectives": true
  }
 },
 "overrides": [
  {
   "includes": ["**/*.test.ts", "**/test/**"],
   "linter": {
    "rules": {
     "style": {
      "noNonNullAssertion": "off"
     },
     "correctness": {
      "noUnusedVariables": "off",
      "noUnusedImports": "off"
     }
    }
   }
  },
  {
   "includes": ["apps/docs/**"],
   "linter": {
    "rules": {
     "suspicious": {
      "noAssignInExpressions": "off",
      "noArrayIndexKey": "off"
     },
     "a11y": {
      "noStaticElementInteractions": "off"
     },
     "correctness": {
      "noUnusedVariables": "off"
     }
    }
   }
  },
  {
   "includes": ["apps/dashboard/**"],
   "linter": {
    "rules": {
     "suspicious": {
      "noExplicitAny": "off"
     }
    }
   }
  },
  {
   "includes": ["**/*.json", "**/*.jsonc", "**/*.yml", "**/*.yaml"],
   "formatter": {
    "indentStyle": "space",
    "indentWidth": 1
   }
  },
  {
   "includes": ["**/*.jsonc"],
   "formatter": {
    "trailingCommas": "none"
   }
  },
  {
   "includes": ["**/package.json", "package.json"],
   "formatter": {
    "enabled": false
   }
  }
 ],
 "linter": {
  "enabled": true,
  "rules": {
   "preset": "recommended"
  }
 },
 "javascript": {
  "formatter": {
   "quoteStyle": "double"
  }
 },
 "assist": {
  "enabled": false,
  "actions": {
   "source": {
    "organizeImports": "on"
   }
  }
 }
}
