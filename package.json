{
	"name": "muljax-id",
	"version": "1.2.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"format": "bunx biome format --write .",
		"check": "bunx biome check .",
		"check:fix": "bunx biome check . --write",
		"build": "bun run build:api && bun run build:dashboard && bun run build:docs",
		"build:dashboard": "bun --cwd=apps/dashboard run build",
		"build:api": "bun --cwd=apps/api run build",
		"build:docs": "bun --cwd=apps/docs run build",
		"vars": "bun scripts/generate-tfvars.ts && bun scripts/oidc-key.ts && bun scripts/ssh-ca-key.ts",
		"seed": "bun scripts/seed-d1.ts",
		"seed:local": "bun scripts/seed-d1.ts --local",
		"deploy": "bun run vars && bun run build && terraform -chdir=terraform apply && bun run seed",
		"typecheck": "bun run typecheck:api && bun run typecheck:crypto && bun run typecheck:rebac && bun run typecheck:dashboard && bun run typecheck:docs",
		"typecheck:crypto": "bun --cwd=packages/crypto run typecheck",
		"typecheck:rebac": "bun --cwd=packages/rebac run typecheck",
		"typecheck:dashboard": "bun --cwd=apps/dashboard run typecheck",
		"typecheck:api": "bun --cwd=apps/api run typecheck",
		"typecheck:docs": "bun --cwd=apps/docs run typecheck",
		"test": "bun --cwd=apps/api test && bun --cwd=packages/crypto test && bun --cwd=packages/rebac test",
		"test:api": "bun --cwd=apps/api test",
		"test:crypto": "bun --cwd=packages/crypto test",
		"test:rebac": "bun --cwd=packages/rebac test",
		"bench:rebac": "bun --cwd=packages/rebac run bench",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@types/bun": "1.4.2",
		"husky": "9.1.7",
		"miniflare": "^4.0.0",
		"typescript": "7.0.2",
		"workerd": "^1.20260918.1"
	},
	"dependencies": {
		"drizzle-orm": "1.0.0-rc.5-ab785fc"
	}
}
