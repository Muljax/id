{
  "version": "0.14.3",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "format": "bunx biome format --write .",
    "check": "bunx biome check .",
    "dev": "alchemy dev",
    "check:fix": "bunx biome check . --fix",
    "build:dashboard": "bun --cwd=apps/dashboard run build",
    "typecheck": "bunx tsc --build",
    "typecheck:dashboard": "bunx tsc -p apps/dashboard/tsconfig.json --noEmit",
    "typecheck:api": "bunx tsc -p apps/api/tsconfig.json --noEmit",
    "plan": "alchemy plan",
    "deploy": "alchemy deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "1.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "husky": "9.1.7",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@noble/curves": "^2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.1",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112",
    "wrangler": "4.129.0"
  }
}
