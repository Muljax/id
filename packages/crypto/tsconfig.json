{
 "compilerOptions": {
  "lib": ["ESNext", "DOM"],
  "types": ["bun"],
  "target": "ESNext",
  "module": "Preserve",
  "moduleResolution": "Bundler",
  "moduleDetection": "force",
  "strict": true,
  "noEmit": true,
  "verbatimModuleSyntax": true,
  "skipLibCheck": true,
  "noFallthroughCasesInSwitch": true,
  "noImplicitOverride": true,
  "paths": {
   "@/*": ["./src/*"]
  }
 },
 "include": ["./src", "./test"]
}
